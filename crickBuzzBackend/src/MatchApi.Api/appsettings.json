{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ApplicationInsights": {
    "Enabled": true,
    "ConnectionString": ""
  },
  "AllowedHosts": "*",
